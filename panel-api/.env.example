# Copy this file to panel-api/.env on the production server, fill in values, then
# `docker compose -f docker-compose.prod.yml up -d`.
# panel-api/.env is gitignored — never commit a real secret.

# Random 64-char hex (openssl rand -hex 32). REQUIRED in production — the API
# will refuse to start without it. In dev a per-process random is minted with
# a warning.
JWT_SECRET=

# Initial seed user — only used the very first time the DB is created.
# After that, change credentials inside the app.
SEED_EMAIL=mani_golchin@kalku.de
SEED_NAME=Mani Golchin
SEED_PASSWORD=
SEED_COMPANY=

# SMTP credentials for transactional email (post-approve certificate to the
# customer, daily digest to the owner). If any of the four are unset the
# mailer logs "not_configured" and skips outbound sends; approval still
# succeeds, customer just doesn't get a receipt email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KALKU Panel <noreply@kalku.de>"

# Shared secret for POST /api/panel/digest/run (cron entry point). Returns
# 403 if the request header `x-digest-secret` doesn't match. If unset the
# digest endpoint returns 503 (digest_not_configured) — set this to enable
# host-cron triggering.
DIGEST_SECRET=

# SSO handoff to preisanfrage. Dedicated shared secret (NOT JWT_SECRET) used to
# sign the one-time login ticket that preisanfrage's /api/auth/sso verifies.
# Must match preisanfrage's SSO_HANDOFF_SECRET exactly. 64-char hex
# (openssl rand -hex 32). Empty/short = SSO disabled; the Submissionskarte /
# Statistik links then open preisanfrage's normal login instead.
SSO_HANDOFF_SECRET=
